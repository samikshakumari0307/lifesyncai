rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Users Collection & Subcollections
    match /users/{userId} {
      
      // Allow the user to read and write their own profile document
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Cascading subcollection security rule
      // This applies to ALL subcollections inside the user's document
      // (e.g., /users/{userId}/tasks/{taskId}, /users/{userId}/notes/{noteId})
      match /{collectionName}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 2. Default Deny
    // Secure by default: block all access to any unknown or future root collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
